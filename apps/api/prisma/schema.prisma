// ProcureStack schema. Change it only via `pnpm db:migrate` (creates a migration file).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors @procurestack/shared ROLES — keep in sync (a unit test enforces it).
enum Role {
  REQUESTER
  APPROVER
  BUYER
  WAREHOUSE
  FINANCE
  ADMIN
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  fullName      String
  passwordHash  String
  /// A person can hold several roles; SoD conflicts are checked per action, not here.
  roles         Role[]
  isActive      Boolean  @default(true)
  /// DoA authority (ADR 0004): may approve PR steps up to this level. Null = no authority.
  approvalLevel Int?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  requisitions  PurchaseRequisition[]
  prApprovals   PrApproval[]
  rfxEvents     RfxEvent[]

  @@map("users")
}

/// Opaque refresh tokens, stored only as SHA-256 hashes. Every rotation creates a new
/// row in the same `familyId`; presenting an already-rotated token revokes the family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only trail of sensitive actions (who, what, when, before/after).
/// `onDelete: Restrict` means a user with audit history cannot be hard-deleted — deactivate instead.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Strict insertion order (timestamps can tie); basis for a hash chain later.
  seq        BigInt   @unique @default(autoincrement())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One row per document type (PR, PO, …): gap-free numbering, see ADR 0005.
model DocumentCounter {
  type  String @id
  value Int

  @@map("document_counters")
}

// ───────────────────────────── Master data ─────────────────────────────

/// Mirrors @procurestack/shared UOMS.
enum Uom {
  EA
  KG
  M
  L
  BOX
}

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  /// ISO 3166-1 alpha-2; drives import duties and (Phase 4) LkSG country risk.
  countryCode String   @db.Char(2)
  email       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  rfxInvitations RfxInvitation[]
  rfxBids        RfxBid[]

  @@map("suppliers")
}

model Item {
  id                 String   @id @default(uuid()) @db.Uuid
  sku                String   @unique
  description        String
  uom                Uom
  category           String
  /// EUR cents (ADR 0005). Reference price for requisition estimates.
  standardPriceCents BigInt
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  prLines  PrLine[]
  rfxLines RfxLine[]

  @@map("items")
}

model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  requisitions PurchaseRequisition[]

  @@map("cost_centers")
}

// ───────────────────────────── Requisitions ─────────────────────────────

/// Delegation of Authority matrix (ADR 0004). Reference data, seeded by migration.
model DoaLevel {
  level          Int     @id
  name           String
  /// Highest PR total (EUR cents) this level may approve; null = unlimited.
  maxAmountCents BigInt?

  @@map("doa_levels")
}

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

model PurchaseRequisition {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique
  requesterId    String    @db.Uuid
  costCenterId   String    @db.Uuid
  title          String
  justification  String
  needByDate     DateTime  @db.Date
  status         PrStatus  @default(DRAFT)
  totalCents     BigInt
  /// Fixed at submit from the DoA matrix; 0 while in draft.
  requiredLevels Int       @default(0)
  /// Incremented on every submit, so approvals of a returned version don't count again.
  approvalRound  Int       @default(0)
  /// Optimistic lock (ADR 0006).
  version        Int       @default(1)
  submittedAt    DateTime? @db.Timestamptz(3)
  decidedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  requester  User         @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  costCenter CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  lines      PrLine[]
  approvals  PrApproval[]

  @@index([requesterId])
  @@index([status])
  @@map("purchase_requisitions")
}

model PrLine {
  id             String         @id @default(uuid()) @db.Uuid
  requisitionId  String         @db.Uuid
  lineNo         Int
  itemId         String         @db.Uuid
  /// Snapshots: master-data edits must not rewrite what was requested.
  description    String
  uom            Uom
  quantity       Decimal        @db.Decimal(14, 3)
  unitPriceCents BigInt
  lineTotalCents BigInt
  /// Sourcing backlog: OPEN once the PR is approved; claimed by an RFx, then a PO.
  sourcingStatus SourcingStatus @default(OPEN)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item                @relation(fields: [itemId], references: [id], onDelete: Restrict)
  rfxLines    RfxLine[]

  @@unique([requisitionId, lineNo])
  @@map("pr_lines")
}

/// One decision per (PR, round, level): the unique key stops two approvers racing on a step.
model PrApproval {
  id            String           @id @default(uuid()) @db.Uuid
  requisitionId String           @db.Uuid
  round         Int
  level         Int
  approverId    String           @db.Uuid
  decision      ApprovalDecision
  comment       String?
  decidedAt     DateTime         @default(now()) @db.Timestamptz(3)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  approver    User                @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([requisitionId, round, level])
  @@map("pr_approvals")
}

// ───────────────────────────── Sourcing (RFx) ─────────────────────────────

enum SourcingStatus {
  OPEN
  IN_SOURCING
  AWARDED
  ORDERED
}

enum RfxType {
  RFI
  RFP
  RFQ
}

enum RfxStatus {
  DRAFT
  PUBLISHED
  CLOSED
  EVALUATED
  AWARDED
  CANCELLED
}

enum InvitationStatus {
  INVITED
  RESPONDED
  DECLINED
}

/// Mirrors @procurestack/shared INCOTERMS.
enum Incoterm {
  EXW
  FCA
  CPT
  CIP
  DAP
  DPU
  DDP
  FAS
  FOB
  CFR
  CIF
}

enum BidSource {
  MANUAL
  SIMULATED
}

model RfxEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  number             String    @unique
  type               RfxType
  title              String
  buyerId            String    @db.Uuid
  status             RfxStatus @default(DRAFT)
  responseDeadline   DateTime  @db.Timestamptz(3)
  publishedAt        DateTime? @db.Timestamptz(3)
  closedAt           DateTime? @db.Timestamptz(3)
  evaluatedAt        DateTime? @db.Timestamptz(3)
  awardedAt          DateTime? @db.Timestamptz(3)
  /// Why an award did not go to the best landed-cost offer (compliance).
  awardJustification String?
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  buyer       User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  lines       RfxLine[]
  invitations RfxInvitation[]
  bids        RfxBid[]

  @@index([status])
  @@map("rfx_events")
}

model RfxLine {
  id               String  @id @default(uuid()) @db.Uuid
  rfxId            String  @db.Uuid
  lineNo           Int
  prLineId         String  @db.Uuid
  itemId           String  @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  uom              Uom
  awardedBidLineId String? @unique @db.Uuid

  rfx            RfxEvent     @relation(fields: [rfxId], references: [id], onDelete: Cascade)
  prLine         PrLine       @relation(fields: [prLineId], references: [id], onDelete: Restrict)
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  awardedBidLine RfxBidLine?  @relation("AwardedBidLine", fields: [awardedBidLineId], references: [id], onDelete: Restrict)
  bidLines       RfxBidLine[] @relation("BidLineRfxLine")

  @@unique([rfxId, lineNo])
  @@index([prLineId])
  @@map("rfx_lines")
}

model RfxInvitation {
  rfxId       String           @db.Uuid
  supplierId  String           @db.Uuid
  status      InvitationStatus @default(INVITED)
  respondedAt DateTime?        @db.Timestamptz(3)

  rfx      RfxEvent @relation(fields: [rfxId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@id([rfxId, supplierId])
  @@map("rfx_invitations")
}

/// One bid per supplier per event; a revised bid before the deadline replaces it.
model RfxBid {
  id                       String    @id @default(uuid()) @db.Uuid
  rfxId                    String    @db.Uuid
  supplierId               String    @db.Uuid
  incoterm                 Incoterm
  leadTimeDays             Int
  validUntil               DateTime  @db.Date
  originChargesCents       BigInt    @default(0)
  freightCents             BigInt    @default(0)
  insuranceCents           BigInt    @default(0)
  destinationHandlingCents BigInt    @default(0)
  dutyRateBps              Int       @default(0)
  source                   BidSource
  submittedAt              DateTime  @default(now()) @db.Timestamptz(3)

  rfx      RfxEvent     @relation(fields: [rfxId], references: [id], onDelete: Cascade)
  supplier Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines    RfxBidLine[]

  @@unique([rfxId, supplierId])
  @@map("rfx_bids")
}

model RfxBidLine {
  id             String @id @default(uuid()) @db.Uuid
  bidId          String @db.Uuid
  rfxLineId      String @db.Uuid
  unitPriceCents BigInt

  bid        RfxBid   @relation(fields: [bidId], references: [id], onDelete: Cascade)
  rfxLine    RfxLine  @relation("BidLineRfxLine", fields: [rfxLineId], references: [id], onDelete: Cascade)
  awardedFor RfxLine? @relation("AwardedBidLine")

  @@unique([bidId, rfxLineId])
  @@map("rfx_bid_lines")
}
