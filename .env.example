# Copy to .env with `pnpm env:init` (fills every secret with a strong random value).
# .env is git-ignored. Never commit real secrets. Values marked __GENERATE__ are secrets.

# --- Postgres container ---
# Database superuser created on first start
POSTGRES_USER=procurestack
# Database password (hex only, so it is URL-safe inside DATABASE_URL)
POSTGRES_PASSWORD=__GENERATE__
# Database name
POSTGRES_DB=procurestack
# Host port for local tools (5433 avoids clashing with a locally installed Postgres)
POSTGRES_HOST_PORT=5433

# --- Redis container ---
# Redis AUTH password
REDIS_PASSWORD=__GENERATE__
# Host port for local tools
REDIS_HOST_PORT=6380

# --- Web container ---
# Host port where the app is served (http://localhost:8080)
WEB_HOST_PORT=8080

# --- API (these are used when running `pnpm dev` on the host; compose builds its own URLs) ---
# development | test | production
NODE_ENV=development
# HTTP port of the Nest API
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Postgres connection string (host-side port)
DATABASE_URL=postgresql://procurestack:${POSTGRES_PASSWORD}@localhost:5433/procurestack
# Redis connection string (host-side port)
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380
# HMAC key for signing access tokens; at least 32 random characters
JWT_ACCESS_SECRET=__GENERATE__
# Access token lifetime in seconds (short: it cannot be revoked before expiry)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime in days (rotated on every use, revocable)
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Send the refresh cookie only over HTTPS. Must be true in production; false is fine on localhost
COOKIE_SECURE=false
# Serve Swagger UI at /api/docs
SWAGGER_ENABLED=true

# --- Seed ---
# Password given to every seeded demo user (dev only)
SEED_DEFAULT_PASSWORD=__GENERATE__
